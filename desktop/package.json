{
  "name": "durus-masaustu",
  "productName": "Duruş",
  "version": "1.4.6",
  "description": "Duruş ergonomi analiz merkezi — Windows masaüstü sürümü",
  "author": "Yusuf Durak",
  "license": "SEE LICENSE IN LICENSE.md",
  "private": true,
  "repository": "github:ysfdurak/durus-ergonomi",
  "main": "main.js",
  "scripts": {
    "hazirla": "node hazirla.mjs",
    "start": "node hazirla.mjs && electron .",
    "dist": "node hazirla.mjs && electron-builder --win --publish never"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.1.0",
    "@fontsource/ibm-plex-sans": "^5.1.0",
    "@mediapipe/pose": "0.5.1675469404",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.1",
    "exceljs": "4.4.0",
    "pdfmake": "0.3.14"
  },
  "build": {
    "appId": "com.ysfdurak.durus",
    "productName": "Duruş",
    "artifactName": "Durus-${version}-${arch}-${os}.${ext}",
    "files": [
      "main.js",
      "web/**/*",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "Durus-${version}-tasinabilir.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Duruş",
      "artifactName": "Durus-${version}-kurulum.exe",
      "installerLanguages": [
        "tr_TR",
        "en_US"
      ],
      "multiLanguageInstaller": true
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "loadBrowserProcessSpecificV8Snapshot": false,
      "grantFileProtocolExtraPrivileges": false
    }
  },
  "overrides": {
    "minimatch@>=7 <11": "^11.0.1",
    "uuid": "^11.1.1"
  }
}
